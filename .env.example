APP_MODE=demo
APP_ACCESS_TOKEN=replace_with_a_long_random_private_token
LLM_API_STYLE=openai
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=inclusionai/ling-3.2-flash:free
LLM_API_KEY=
# Optional Responses API adapter (see docs/YANDEX_SETUP.md).
# LLM_API_STYLE=responses
# LLM_BASE_URL=https://ai.api.cloud.yandex.net/v1
# LLM_MODEL=gpt://YOUR_FOLDER_ID/aliceai-llm-flash
# LLM_AUTH_SCHEME=api-key
# LLM_PROJECT=YOUR_FOLDER_ID
LLM_TIMEOUT_SECONDS=300
MAX_AGENT_ROUNDS=3
MAX_TOOL_CALLS=10
MAX_OUTPUT_TOKENS=2048
REQUESTS_PER_MINUTE=12
MAX_CONCURRENT_REQUESTS=2
SEED_LOANS=10000
